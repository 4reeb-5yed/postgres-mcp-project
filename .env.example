# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Phase 1: Docker + Claude Desktop ---
PHASE1_CONTAINER_NAME=local-postgres
PHASE1_POSTGRES_PASSWORD=changeme
# Port 5433, not the Postgres default 5432 — see README "Gotchas" for why
# (a native Windows Postgres service was already bound to 5432 on the dev machine).
PHASE1_POSTGRES_PORT=5433
