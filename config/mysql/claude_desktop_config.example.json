{
  "mcpServers": {
    "mysql-mcp": {
      "command": "uvx",
      "args": ["--from", "mysql-mcp-server", "mysql_mcp_server"],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "<YOUR_PASSWORD>",
        "MYSQL_DATABASE": "testdb"
      }
    }
  }
}
